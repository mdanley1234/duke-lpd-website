---
import { Image } from "astro:assets";
import { Rocket, ArrowRight } from "@lucide/astro";
import { projects } from "../data/projects";
import MachDiamonds from "./MachDiamonds.astro";

// A rail, not a grid of cards: these are sequential and dated, and the parent
// site already reaches for a rail whenever the left column is a label
// (join.astro's day column, team.astro's index column). The spine and the node
// markers are the only things added on top of that idiom.
//
// No ember field here. AboutSection above already opens with one, and repeating
// it would make the two sections read as the same entrance twice. The section
// closes on its own motif instead: a mach-diamond field standing in the
// background, so the page's last section fades out on the same exhaust the
// team is chasing on the test stand.
---

<section id="projects" class="relative overflow-hidden bg-night">
  <MachDiamonds class="pointer-events-none absolute inset-x-0 bottom-0" />

  <div
    class="relative z-10 mx-auto max-w-7xl px-6 pt-24 pb-24 md:px-12 md:pt-32 md:pb-32"
  >
    <div class="flex items-center gap-2">
      <Rocket class="size-5 text-accent-orange md:size-6" />
      <p
        class="font-display text-xs font-bold tracking-[0.14em] text-accent-peach md:text-base"
      >
        PROJECTS
      </p>
    </div>
    {
      /* Split masthead, matching AboutSection above: heading and body sit
        side by side rather than stacked. Collapses to a stack below md. */
    }
    <div class="mt-3 grid gap-6 md:grid-cols-2 md:gap-12 lg:gap-20">
      <h2
        class="text-balance text-white font-display text-[clamp(28px,3.4vw,52px)] font-bold leading-tight"
      >
        The engines we've built so far.
      </h2>
      <p class="text-sm leading-relaxed text-white/80 md:pt-2 md:text-base">
        Eno was supposed to reach a hot fire, but cold-flow testing turned up
        more problems than were worth patching, so the team started over.
        Prometheus is the engine that came out of that restart, built on exactly
        what the testing showed. Below, each workstream is real hardware someone
        on the team designed, machined, or wired themselves.
      </p>
    </div>

    {/* Ordered, because the sequence is the content: this is a chronology. */}
    <ol class="mt-16 md:mt-20">
      {
        projects.map((project, i) => (
          <li
            class:list={[
              "project relative pl-7 md:grid md:grid-cols-[7rem_1fr] md:gap-x-12 md:pl-0",
              i === projects.length - 1 ? "is-last pb-0" : "pb-28 md:pb-36",
            ]}
          >
            <span class="node" data-status={project.status} aria-hidden="true">
              <span class="node-ring" />
            </span>

            <p class="font-mono text-xs tracking-[0.14em] text-white/60 md:pt-1 md:text-right">
              {project.years}
            </p>

            <div class="mt-3 md:mt-0">
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
                <h3 class="font-display text-xl font-bold text-white md:text-2xl">
                  {project.name}
                </h3>
                {/* Real text, not a coloured dot — status must survive with
                    colour removed. */}
                <span
                  class:list={[
                    "chip",
                    project.status === "active" ? "chip-active" : "chip-past",
                  ]}
                >
                  {project.statusLabel}
                </span>
              </div>

              {/* Hardware and prose share a row from xl up — the first width at
                  which a 24rem plate still leaves the objective its measure.
                  The plate stretches to whatever height the prose column ends
                  up at rather than holding a box of its own: only a finished
                  project carries an outcome, so a fixed plate would open a
                  differently sized hole under each entry. Letting the crop
                  absorb that difference is free here because both covers are
                  centred on their subject.

                  The plate leads the prose in the source so the stacked layout
                  reads name, then hardware, then the argument for it. */}
              <div class="mt-5 xl:grid xl:grid-cols-[minmax(0,1fr)_24rem] xl:gap-x-10">
                {/* Deliberately not a link: "Learn more" below is the entry's
                    one destination, and a second route to it would split the
                    click the same way ProjectCard keeps its face and its
                    disclosure apart. */}
                <div class="cover max-w-lg xl:col-start-2 xl:row-start-1">
                  <Image
                    src={project.cover}
                    alt={project.coverAlt}
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 1280px) 24rem, (min-width: 768px) 32rem, 88vw"
                    class="block aspect-4/3 w-full object-cover xl:absolute xl:inset-0 xl:aspect-auto xl:h-full"
                  />
                </div>

                <div class="mt-6 xl:col-start-1 xl:row-start-1 xl:mt-0">
                  {/* Objective and outcome read as one paragraph here, same as an
                      active project with no outcome yet — the labelled "Outcome"
                      callout is the project detail page's job, where there's room
                      to give it its own beat. */}
                  <p class="max-w-2xl text-sm leading-relaxed text-white/70 md:text-base">
                    {project.objective} {project.outcome}
                  </p>
                  <ul class="mt-7 border-t border-white/10">
                    {project.workstreams.map((workstream) => (
                      <li class="grid gap-x-5 gap-y-1 border-b border-white/10 py-4 sm:grid-cols-[2rem_minmax(0,11rem)_1fr]">
                        <span class="font-mono text-xs text-accent-peach">
                          {workstream.index}
                        </span>
                        <span class="font-display text-sm font-bold text-white">
                          {workstream.name}
                        </span>
                        <span class="text-sm leading-relaxed text-white/70">
                          {workstream.summary}
                        </span>
                      </li>
                    ))}
                  </ul>

                  {/* Both projects have a detailHref now, so this resolves to
                  their MDX page; the fallback to this same section only guards
                  a future project added without a detail page yet. */}
                  <a
                    href={project.detailHref ?? "/#projects"}
                    class="learn-more group/more mt-7 inline-flex items-center gap-2 border border-white/15 px-4 py-3 font-display text-sm font-bold text-white transition-colors hover:border-accent-orange hover:bg-accent-orange hover:text-night"
                  >
                    Learn more about {project.name}
                    <ArrowRight
                      class="size-4 transition-transform group-hover/more:translate-x-1"
                      aria-hidden="true"
                    />
                  </a>
                </div>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* The spine sits at the left edge on mobile and between the two grid columns
     at md+, so its x-position is the one thing that moves between breakpoints. */
  .project {
    --spine-x: 0px;
  }

  /* Two layers: a dim static rail, plus a bright comet-shaped band that
     travels the full length of the rail on a loop — the "shooting light"
     read as energy running down the timeline. The comet is authored bottom-
     heavy (brightest near 90%, sharp cutoff after) so the leading edge reads
     as a point with a trail behind it, not a symmetric blob. Sized in a
     fixed px band rather than tied to the element's own height, so the
     travel distance (padded 160px past each end) works the same on Eno's
     shorter segment and Prometheus's much taller one — they won't be
     phase-locked, but each reads as a continuous flow on its own rail. */
  .project::before {
    content: "";
    position: absolute;
    /* Starts at the node's own centerline (top: 0.3rem + half its 0.6rem
       height) instead of the li's top edge, so the rail — and the light
       traveling on it — originates from inside the dot rather than poking
       out above it. */
    top: 0.6rem;
    bottom: 0;
    left: var(--spine-x);
    width: 1px;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.12), rgb(255 255 255 / 0.12)),
      linear-gradient(
        to bottom,
        transparent 0%,
        rgb(237 104 34 / 0.85) 75%,
        #fff5ec 92%,
        transparent 100%
      );
    background-size:
      100% 100%,
      100% 160px;
    background-repeat: no-repeat, no-repeat;
    background-position:
      0 0,
      0 -160px;
    animation: spine-flow 3.6s linear infinite;
  }

  @keyframes spine-flow {
    from {
      background-position:
        0 0,
        0 -160px;
    }
    to {
      background-position:
        0 0,
        0 calc(100% + 160px);
    }
  }

  /* The last project is still running, so its segment fades out downward rather
     than stopping on a hard tick — the timeline runs off into work not done.
     A mask rather than another background layer, so it fades the rail and
     the traveling light together instead of just sitting on top of them. */
  .project.is-last::before {
    bottom: -4rem;
    mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 45%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 45%,
      transparent 100%
    );
  }

  /* A floating arrowhead centered on the page, in the (now much bigger) gap
     between a finished project and the one it led to — a small "keep
     reading down" cue marking the handoff, rather than leaving that much
     empty space feeling dead. Pure CSS triangle, no icon import, to match
     how .node is already just a hand-drawn shape. Skipped on the last
     project since nothing follows it to hand off to. */
  .project:not(.is-last)::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 3.5rem;
    width: 0;
    height: 0;
    border-left: 12px solid transparent;
    border-right: 12px solid transparent;
    border-top: 16px solid var(--color-accent-orange);
    animation: arrow-float 2.6s ease-in-out infinite;
  }

  @keyframes arrow-float {
    0%,
    100% {
      transform: translate(-50%, 0);
    }
    50% {
      transform: translate(-50%, 8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project::before,
    .project:not(.is-last)::after {
      animation: none;
    }
  }

  .node {
    position: absolute;
    top: 0.3rem;
    left: var(--spine-x);
    width: 0.6rem;
    height: 0.6rem;
    transform: translateX(-50%);
    border-radius: 9999px;
  }

  .node[data-status="past"] {
    background: var(--color-night);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.35);
  }

  .node[data-status="active"] {
    background: var(--color-accent-orange);
  }

  .node-ring {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
  }

  /* One authored moment in the section, on the one element whose state it
     describes: the project that is still running. */
  .node[data-status="active"] .node-ring {
    box-shadow: 0 0 0 1px var(--color-accent-orange);
    animation: node-pulse 3.4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  @keyframes node-pulse {
    0% {
      opacity: 0.55;
      transform: scale(1);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(2.8);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .node[data-status="active"] .node-ring {
      animation: none;
    }
  }

  @media (min-width: 768px) {
    .project {
      /* Column one (7rem) plus half the 3rem gap: the spine lands in the gutter
         rather than against either column's text. */
      --spine-x: 8.5rem;
    }

    .project:not(.is-last)::after {
      bottom: 4.5rem;
    }
  }

  /* Both covers are shop photography lit by overhead fluorescents, which makes
     them the brightest thing in a section set on near-black. The frame plus a
     hairline catch along the top edge and a little of the night colour pulled
     back into the bottom keeps a plate reading as seated on the ground rather
     than cut through it — the bottom is where both photos are loudest, being
     bench and towel. */
  .cover {
    position: relative;
    border: 1px solid rgb(255 255 255 / 0.1);
    box-shadow: 0 22px 44px -26px rgb(0 0 0 / 0.9);
  }

  .cover::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgb(255 255 255 / 0.1) 0 1px, transparent 1px),
      linear-gradient(to top, rgb(16 16 19 / 0.35) 0%, transparent 28%);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    border: 1px solid;
    padding: 0.2rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .chip-active {
    border-color: rgb(237 104 34 / 0.45);
    background: rgb(237 104 34 / 0.12);
    color: var(--color-accent-peach);
  }

  .chip-past {
    border-color: rgb(255 255 255 / 0.18);
    color: rgb(255 255 255 / 0.65);
  }
</style>
