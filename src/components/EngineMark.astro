---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Purely decorative: line-art hardware (the engineering) with an animated
// flame and rising embers (the combustion) — the same warm/cool pairing the
// rest of the site uses, just drawn rather than photographed. Nozzle points
// down, matching how an engine actually sits on a rocket in flight, so it
// reads immediately without a caption.
---

<svg class={className} viewBox="0 0 200 288" fill="none" aria-hidden="true">
  {
    /* Hardware: injector, chamber, throat, bell — stroke only, open at the
      nozzle exit so the flame reads as emerging from it rather than sitting
      in front of it. */
  }
  <path
    class="engine-line"
    d="M72,4 L128,4 L128,46 C128,54 122,56 116,70 C152,84 168,140 172,166
       M72,4 L72,46 C72,54 78,56 84,70 C48,84 32,140 28,166"
    stroke="rgb(255 255 255 / 0.34)"
    stroke-width="3"
    stroke-linejoin="round"
    stroke-linecap="round"></path>
  {
    /* Feed-line stubs and a chamber seam — small technical detail, same idea
      as the P&ID-style line art already used for the Fluid Systems card. */
  }
  <path
    class="engine-detail"
    d="M58,2 L72,14 M142,2 L128,14 M76,25 L124,25 M84,71 L116,71"
    stroke="rgb(255 255 255 / 0.18)"
    stroke-width="1.5"
    stroke-linecap="round"></path>

  <ellipse class="engine-glow" cx="100" cy="195" rx="80" ry="52" fill="#ed6822"
  ></ellipse>

  {
    /* Three flame layers, widest and dimmest to smallest and brightest, each
      closing with a straight edge across the nozzle exit so the plume reads
      as attached to the bell rather than floating under it. Each flickers on
      its own timing so they never lock into one shape. */
  }
  <g class="flame flame-outer">
    <path
      d="M28,166 C42,198 62,232 84,256 Q100,272 116,256 C138,232 158,198 172,166 Z"
      fill="#ed6822"></path>
  </g>
  <g class="flame flame-mid">
    <path
      d="M40,170 C52,198 68,228 86,248 Q100,260 114,248 C132,228 148,198 160,170 Z"
      fill="#ff8a3d"></path>
  </g>
  <g class="flame flame-core">
    <path
      d="M58,174 C68,196 80,216 92,228 Q100,236 108,228 C120,216 132,196 142,174 Z"
      fill="#ffd9c2"></path>
  </g>

  {
    /* A few embers shedding off the plume — the same warm-to-white palette
      as the ember field, just a handful of fixed particles instead of a
      seeded scatter, since there's no area here to fill. */
  }
  <circle class="spark spark-1" cx="16" cy="202" r="1.8" fill="#ffb596"
  ></circle>
  <circle class="spark spark-2" cx="184" cy="208" r="1.6" fill="#ff8a3d"
  ></circle>
  <circle class="spark spark-3" cx="10" cy="238" r="1.4" fill="#ffd9c2"
  ></circle>
  <circle class="spark spark-4" cx="190" cy="230" r="1.5" fill="#ffb596"
  ></circle>
  <circle class="spark spark-5" cx="100" cy="284" r="2" fill="#ff8a3d"></circle>
</svg>

<style>
  .flame,
  .spark {
    transform-box: fill-box;
  }

  .flame {
    transform-origin: 50% 0%;
  }

  .flame-outer {
    filter: blur(4px);
    opacity: 0.5;
    animation: flicker-outer 2.6s ease-in-out infinite;
  }

  .flame-mid {
    filter: blur(1px);
    opacity: 0.85;
    animation: flicker-mid 1.9s ease-in-out infinite;
  }

  .flame-core {
    opacity: 0.95;
    animation: flicker-core 1.3s ease-in-out infinite;
  }

  .engine-glow {
    filter: blur(20px);
    opacity: 0.2;
    animation: glow-pulse 3.2s ease-in-out infinite;
  }

  @keyframes flicker-outer {
    0%,
    100% {
      transform: scaleY(1) scaleX(1);
      opacity: 0.46;
    }
    30% {
      transform: scaleY(1.1) scaleX(0.95);
      opacity: 0.58;
    }
    55% {
      transform: scaleY(0.92) scaleX(1.05);
      opacity: 0.42;
    }
    80% {
      transform: scaleY(1.04) scaleX(0.98);
      opacity: 0.55;
    }
  }

  @keyframes flicker-mid {
    0%,
    100% {
      transform: scaleY(1) scaleX(1);
      opacity: 0.78;
    }
    35% {
      transform: scaleY(1.14) scaleX(0.93);
      opacity: 0.95;
    }
    65% {
      transform: scaleY(0.9) scaleX(1.06);
      opacity: 0.72;
    }
  }

  @keyframes flicker-core {
    0%,
    100% {
      transform: scaleY(1) translateY(0);
      opacity: 0.9;
    }
    40% {
      transform: scaleY(1.16) translateY(-2px);
      opacity: 1;
    }
    70% {
      transform: scaleY(0.88) translateY(1px);
      opacity: 0.82;
    }
  }

  @keyframes glow-pulse {
    0%,
    100% {
      opacity: 0.14;
      transform: scale(0.96);
    }
    50% {
      opacity: 0.24;
      transform: scale(1.05);
    }
  }

  .spark {
    animation: spark-rise 3.2s ease-out infinite;
  }

  .spark-1 {
    animation-delay: 0s;
  }
  .spark-2 {
    animation-delay: 0.5s;
  }
  .spark-3 {
    animation-delay: 1s;
  }
  .spark-4 {
    animation-delay: 1.6s;
  }
  .spark-5 {
    animation-delay: 2.2s;
  }

  @keyframes spark-rise {
    0% {
      transform: translateY(0) scale(0.6);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    100% {
      transform: translateY(-46px) scale(1);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flame,
    .engine-glow,
    .spark {
      animation: none;
    }
  }
</style>
