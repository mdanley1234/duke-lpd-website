---
import { Image } from "astro:assets";
import { ArrowLeft } from "@lucide/astro";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Embers from "../components/Embers.astro";
import { subteams } from "../data/subteams";

// One route rather than three near-identical pages. This is a local array, not a
// content collection — the site still has no CMS layer and doesn't need one for
// three entries.
export function getStaticPaths() {
  return subteams.map((team) => ({
    params: { subteam: team.slug },
    props: { team },
  }));
}

const { team } = Astro.props;
---

<Layout
  title={`${team.name} | Duke AERO Liquid Propulsion`}
  description={team.detail}
>
  <Header />

  <main class="relative bg-night">
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
      <Embers
        class="absolute inset-x-0 top-0 h-110 w-full opacity-70 mask-[linear-gradient(to_bottom,black_50%,transparent)]"
        count={110}
        seed={Number(team.index)}
      />
    </div>

    <div
      class="relative z-10 mx-auto max-w-7xl px-6 pt-32 pb-24 md:px-12 md:pt-40 md:pb-32"
    >
      <a
        href="/#about"
        class="group inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.18em] text-white/60 transition-colors hover:text-white"
      >
        <ArrowLeft
          class="size-3.5 transition-transform group-hover:-translate-x-1"
          aria-hidden="true"
        />
        All subteams
      </a>

      <div class="mt-10 max-w-3xl">
        <p class="font-mono text-xs text-accent-peach">{team.index}</p>
        <h1
          class="text-gradient-metal mt-3 font-display text-[clamp(34px,5.4vw,64px)] font-bold leading-[0.95] tracking-[-0.02em]"
        >
          {team.name}
        </h1>
        <p
          class="mt-6 text-pretty text-base leading-relaxed text-steel-light md:text-lg"
        >
          {team.detail}
        </p>
      </div>

      <!-- The drawing is the subject here rather than a texture, so it gets a
           lighter grade, no crop, and a caption instead of a scrim. -->
      <figure class="mt-14 md:mt-20">
        <div class="border border-white/10 bg-white/[0.02] p-3 md:p-6">
          <Image
            src={team.plate}
            alt={team.plateAlt}
            widths={[700, 1100, team.plate.width]}
            sizes="(min-width: 768px) 80vw, 100vw"
            class="h-auto w-full"
            loading="eager"
          />
        </div>
        <figcaption
          class="mt-4 max-w-3xl text-sm leading-relaxed text-white/60"
        >
          {team.plateCaption}
        </figcaption>
      </figure>

      <div
        class="mt-14 grid gap-10 border-t border-white/10 pt-10 md:mt-20 md:grid-cols-3"
      >
        <dl class="md:col-span-2 grid gap-x-8 gap-y-6 sm:grid-cols-3">
          {
            team.specs.map((spec) => (
              <div>
                <dt class="font-mono text-xs uppercase tracking-[0.18em] text-white/45">
                  {spec.label}
                </dt>
                <dd class="mt-2 font-display text-base font-bold text-white">
                  {spec.value}
                </dd>
              </div>
            ))
          }
        </dl>

        <div>
          <p
            class="font-mono text-xs uppercase tracking-[0.18em] text-white/45"
          >
            Subteam lead
          </p>
          <p class="mt-2 font-display text-base font-bold text-white">
            {team.lead}
          </p>
          <p class="mt-1 font-mono text-xs text-white/60">{team.study}</p>
        </div>
      </div>

      <nav class="mt-16 flex flex-wrap gap-3 border-t border-white/10 pt-10">
        {
          subteams
            .filter((other) => other.slug !== team.slug)
            .map((other) => (
              <a
                href={`/${other.slug}`}
                class="inline-flex items-center gap-3 border border-white/15 px-4 py-3 transition-colors hover:border-white/40"
              >
                <span class="font-mono text-xs text-accent-peach">
                  {other.index}
                </span>
                <span class="font-display text-sm font-bold text-white">
                  {other.name}
                </span>
              </a>
            ))
        }
      </nav>
    </div>
  </main>

  <Footer />
</Layout>
